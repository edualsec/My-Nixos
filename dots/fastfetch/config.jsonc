{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/nixos_logo.txt",
    "padding": {
      "top": 0,
      "right": 2
    },
    "width": 10
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "bright_white",
        "at": "bright_blue",
        "host": "bright_white"
      }
    },
    "break",

    {
      "type": "os",
      "key": " OS",
      "keyColor": "bright_blue"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "bright_blue"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "bright_blue"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "bright_blue"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "bright_blue"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "bright_blue"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "bright_blue"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "bright_blue"
    },
    {
      "type": "memory",
      "key": "󰑭 RAM",
      "keyColor": "bright_blue"
    }
  ]
}