;; ==================================================
;; VARIABLES Y COMANDOS
;; ==================================================
(defpoll current_vol :interval "1s" "pamixer --get-volume || echo 50")
(defpoll current_bright :interval "1s" "brightnessctl -m | cut -d, -f4 | tr -d '%' || echo 50")
(defpoll wifi_active :interval "2s" "nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2 || echo 'Disconnected'")
(defpoll wifi_enabled :interval "2s" "nmcli -t -f WIFI g | grep -q 'enabled' && echo true || echo false")
(defpoll app_volumes :interval "1s" :initial "[]" "~/.config/eww/scripts/get-app-volumes.py")
(defpoll clip_history :interval "1s" :initial "[]" "~/.config/eww/scripts/get-clipboard.py")

;; ==================================================
;; 1. POPUP DE AUDIO (Master + Apps) Y BRILLO
;; ==================================================
(defwidget app_volume_item [app]
  (box :orientation "v" :class "app-vol-entry" :space-evenly false :spacing 4
    (box :orientation "h" :space-evenly false
      (label :class "app-name" :text "${app.name}" :limit-width 22 :halign "start" :hexpand true)
      (label :class "popup-val" :text "${app.volume}%")
    )
    (box :orientation "h" :space-evenly false :spacing 8
      (scale :class "popup-slider app-slider"
             :min 0 :max 101 :value "${app.volume}"
             :onchange "pactl set-sink-input-volume ${app.id} {}%")
    )
  )
)

(defwidget audio_menu []
  (eventbox :onhoverlost "eww close audio_popup"
    (box :class "popup-box" :orientation "v" :space-evenly false :spacing 14
      (label :class "popup-header" :text "Control de Audio")
      
      ;; Slider de Volumen Master
      (box :orientation "h" :space-evenly false :spacing 10
        (label :class "popup-icon" :text "")
        (scale :class "popup-slider"
               :min 0 :max 101 :value current_vol
               :onchange "pamixer --set-volume {}")
        (label :class "popup-val" :text "${current_vol}%")
      )

      ;; Slider de Brillo
      (box :orientation "h" :space-evenly false :spacing 10
        (label :class "popup-icon" :text "󰃠")
        (scale :class "popup-slider"
               :min 1 :max 101 :value current_bright
               :onchange "brightnessctl set {}%")
        (label :class "popup-val" :text "${current_bright}%")
      )

      ;; Separador y Lista de Aplicaciones
      (box :class "audio-separator")
      (label :class "popup-header" :text "Aplicaciones")

      (box :orientation "v" :space-evenly false :spacing 8
        (for app in app_volumes
          (app_volume_item :app app)
        )
        (label :class "no-apps-label" 
               :visible {arraylength(app_volumes) == 0 ? true : false} 
               :text "No hay aplicaciones reproduciendo audio")
      )
    )
  )
)

(defwindow audio_popup
  :monitor 0
  :stacking "overlay"
  :focusable "ondemand"
  :geometry (geometry :anchor "top right" :x "15px" :y "50px" :width "320px")
  (audio_menu)
)

;; ==================================================
;; 2. SELECTOR DE LAYOUTS DE MANGO
;; ==================================================
(defwidget layout_button [glyph name cmd]
  (eventbox :cursor "pointer"
            :onclick "${cmd}; eww close layout_popup"
            :class "layout-btn"
    (box :orientation "v" :space-evenly false :halign "center" :valign "center" :spacing 4
      (label :class "layout-glyph" :text glyph)
      (label :class "layout-label" :text name)
    )
  )
)

(defwidget layout_menu []
  (eventbox :onhoverlost "eww close layout_popup"
    (box :class "popup-box" :orientation "v" :space-evenly false :spacing 12
      (label :class "popup-header" :text "MangoWM Layouts")
      
      ;; Fila 1
      (box :orientation "h" :spacing 10 :space-evenly true
        (layout_button :glyph "󰙀" :name "Tile" :cmd "mmsg dispatch setlayout,tile")
        (layout_button :glyph "󰕴" :name "Dwindle" :cmd "mmsg dispatch setlayout,dwindle")
        (layout_button :glyph "󰕬" :name "Center" :cmd "mmsg dispatch setlayout,center_tile")
      )
      ;; Fila 2
      (box :orientation "h" :spacing 10 :space-evenly true
        (layout_button :glyph "󰕭" :name "Scroller" :cmd "mmsg dispatch setlayout,scroller")
        (layout_button :glyph "󰝘" :name "Grid" :cmd "mmsg dispatch setlayout,grid")
        (layout_button :glyph "󰕮" :name "Monocle" :cmd "mmsg dispatch setlayout,monocle")
      )
    )
  )
)

(defwindow layout_popup
  :monitor 0
  :stacking "overlay"
  :focusable "ondemand"
  :geometry (geometry :anchor "top left" :x "180px" :y "50px" :width "280px")
  (layout_menu)
)

;; ==================================================
;; 3. POPUP DE WI-FI (lista de redes + conectar)
;; ==================================================

;; Pon estas 3 líneas junto a tus otros defpoll/defvar de arriba del todo
(defpoll wifi_list :interval "4s" :initial "[]" "~/.config/eww/scripts/get-wifi.py")
(defvar wifi_selected "")
(defvar wifi_pass "")

(defwidget wifi_item [item]
  (eventbox :cursor "pointer"
            :class "wifi-entry ${item.active ? 'wifi-active' : ''}"
            :onclick "${item.cmd}"
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "wifi-net-icon" :text "${item.icon}")
      (label :class "wifi-net-name" :text "${item.ssid}" :limit-width 22 :halign "start" :hexpand true)
      (label :class "wifi-net-meta" :text "${item.status}")
      (label :class "wifi-net-lock" :text "${item.lock}")
      (label :class "popup-val" :text "${item.signal}%")
    )
  )
)

(defwidget wifi_menu []
  (eventbox :onhoverlost "eww close wifi_popup"
    (box :class "popup-box" :orientation "v" :space-evenly false :spacing 12 :vexpand true
      ;; Cabecera: título + escanear
      (box :orientation "h" :space-evenly false
        (label :class "popup-header" :text "Redes Wi-Fi" :hexpand true :halign "start")
        (button :class "clip-clear-btn" :onclick "nmcli dev wifi rescan" "Escanear")
      )

      ;; Estado + interruptor
      (box :orientation "h" :space-evenly false :spacing 10 :class "wifi-state-box"
        (label :class "popup-icon" :text "")
        (label :class "wifi-ssid" :text wifi_active :hexpand true :halign "start")
        (button :class "wifi-toggle-btn"
                :onclick "nmcli radio wifi ${wifi_enabled == true ? 'off' : 'on'}"
                "${wifi_enabled == true ? 'Desactivar' : 'Activar'}")
      )

      ;; Lista de redes disponibles
      (scroll :vscroll true :hscroll false :class "clip-scroll" :vexpand true
        (box :orientation "v" :space-evenly false :spacing 6
          (for item in wifi_list
            (wifi_item :item item)
          )
          (label :class "no-apps-label"
                 :visible {arraylength(wifi_list) == 0}
                 :text "No se encontraron redes")
        )
      )

      ;; Contraseña (solo aparece al pulsar una red protegida sin guardar)
      (revealer :transition "slidedown" :reveal {wifi_selected != ""}
        (box :class "wifi-pass-box" :orientation "v" :space-evenly false :spacing 8
          (label :class "wifi-pass-title" :halign "start" :limit-width 30
                 :text "Contraseña de ${wifi_selected}")
          (input :class "wifi-pass" :password true
                 :onchange "eww update wifi_pass={}"
                 :onaccept "~/.config/eww/scripts/wifi-connect.sh \"$(eww get wifi_selected)\" \"$(eww get wifi_pass)\"; eww update wifi_selected= wifi_pass=; eww close wifi_popup")
          (box :orientation "h" :space-evenly false :spacing 8 :halign "end"
            (button :class "clip-clear-btn" :onclick "eww update wifi_selected= wifi_pass=" "Cancelar")
          )
        )
      )
    )
  )
)

(defwindow wifi_popup
  :monitor 0
  :stacking "overlay"
  :focusable "ondemand"
  :geometry (geometry :anchor "top right" :x "80px" :y "50px" :width "320px" :height "440px")
  (wifi_menu)
)


;; ==================================================
;; 4. POPUP DE ENERGÍA (Power Menu)
;; ==================================================
(defwidget power_button [icon label cmd]
  (eventbox :cursor "pointer"
            :class "power-action-btn"
            :onclick "${cmd}; eww close power_popup"
    (box :orientation "v" :space-evenly false :halign "center" :valign "center" :spacing 6
      (label :class "power-glyph" :text icon)
      (label :class "power-label" :text label)
    )
  )
)

(defwidget power_menu []
  (eventbox :onhoverlost "eww close power_popup"
    (box :class "popup-box" :orientation "v" :space-evenly false :spacing 12
      (label :class "popup-header" :text "Sistema")
      (box :orientation "h" :spacing 10 :space-evenly true
        (power_button :icon "󰐥" :label "Apagar" :cmd "systemctl poweroff")
        (power_button :icon "󰑐" :label "Reiniciar" :cmd "systemctl reboot")
        (power_button :icon "󰈆" :label "Salir" :cmd "pkill -u $USER")
      )
    )
  )
)

(defwindow power_popup
  :monitor 0
  :stacking "overlay"
  :focusable "ondemand"
  :geometry (geometry :anchor "center" :x "14px" :y "50px" :width "260px")
  (power_menu)
)

;; ==================================================
;; 5. POPUP HISTORIAL DE PORTAPAPELES
;; ==================================================
(defwidget clip_item [item]
  (eventbox :cursor "pointer"
            :class "clip-entry"
            :onclick "~/.config/eww/scripts/copy-clip.sh '${item.id}'; eww close clip_popup"
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "clip-icon" :text "󰆏")
      (label :class "clip-text" :text "${item.preview}" :limit-width 34 :halign "start" :hexpand true)
    )
  )
)

(defwidget clipboard_menu []
  (eventbox :onhoverlost "eww close clip_popup"
    (box :class "popup-box" :orientation "v" :space-evenly false :spacing 10 :vexpand true
      (box :orientation "h" :space-evenly false
        (label :class "popup-header" :text "Historial de Portapapeles" :hexpand true :halign "start")
        (button :class "clip-clear-btn"
                :onclick "cliphist wipe; eww close clip_popup"
                "Limpiar")
      )
      (scroll :vscroll true :hscroll false :class "clip-scroll" :vexpand true
        (box :orientation "v" :space-evenly false :spacing 6
          (for item in clip_history
            (clip_item :item item)
          )
          (label :class "no-apps-label"
                 :visible {arraylength(clip_history) == 0 ? true : false}
                 :text "Portapapeles vacío")
        )
      )
    )
  )
)

(defwindow clip_popup
  :monitor 0
  :stacking "overlay"
  :focusable "ondemand"
  :geometry (geometry :anchor "top right" :x "115px" :y "50px" :width "340px" :height "380px")
  (clipboard_menu)
)

;; ==================================================
;; 6. POPUP DE CALENDARIO
;; ==================================================
(defpoll cal_day :interval "1h" "date '+%d'")
(defpoll cal_year :interval "1h" "date '+%Y'")
(defpoll cal_date :interval "1h" "date '+%A, %d de %B'")

(defwidget calendar_menu []
  (eventbox :onhoverlost "eww close calendar_popup"
    (box :class "popup-box" :orientation "v" :space-evenly false :spacing 10
      (label :class "popup-header" :text cal_date :halign "center")
      (calendar :class "calendar-widget"
                :day cal_day
                :year cal_year)
    )
  )
)

(defwindow calendar_popup
  :monitor 0
  :stacking "overlay"
  :focusable "ondemand"
  :geometry (geometry :anchor "top center" :x "0px" :y "50px" :width "280px")
  (calendar_menu)
)
;; ==================================================
;; VARIABLES Y COMANDOS DE NOTIFICACIONES
;; ==================================================
(defpoll notif_history :interval "1s" :initial "[]" "~/.config/eww/scripts/get-notifications.py")

;; ==================================================
;; POPUP DE NOTIFICACIONES
;; ==================================================
(defwidget notif_item [item]
  (box :orientation "v" :class "notif-entry" :space-evenly false :spacing 4
    (box :orientation "h" :space-evenly false
      (label :class "notif-app" :text "${item.app}" :limit-width 18 :halign "start" :hexpand true)
      (label :class "notif-summary" :text "${item.summary}" :limit-width 20 :halign "end")
    )
    (label :class "notif-body" :text "${item.body}" :limit-width 40 :halign "start" :wrap true)
  )
)

(defwidget notif_menu []
  (eventbox :onhoverlost "eww close notif_popup"
    (box :class "popup-box" :orientation "v" :space-evenly false :spacing 12 :vexpand true
      (box :orientation "h" :space-evenly false
        (label :class "popup-header" :text "Notificaciones" :hexpand true :halign "start")
        (button :class "clip-clear-btn"
                :onclick "dunstctl history-clear; eww close notif_popup"
                "Limpiar")
      )
      (scroll :vscroll true :hscroll false :class "clip-scroll" :vexpand true
        (box :orientation "v" :space-evenly false :spacing 8
          (for item in notif_history
            (notif_item :item item)
          )
          (label :class "no-apps-label"
                 :visible {arraylength(notif_history) == 0 ? true : false}
                 :text "Sin notificaciones pendientes")
        )
      )
    )
  )
)

(defwindow notif_popup
  :monitor 0
  :stacking "overlay"
  :focusable "ondemand"
  :geometry (geometry :anchor "top right" :x "150px" :y "50px" :width "340px" :height "400px")
  (notif_menu)
)

;; ==================================================
;; 7. POPUP DE ESTADO DEL SISTEMA (CPU / RAM / GPU)
;; ==================================================
(defpoll stats :interval "2s"
  :initial "{\"cpu\":{\"usage\":0,\"temp_txt\":\"...\",\"level\":\"na\",\"detail\":\"\"},\"ram\":{\"usage\":0,\"temp_txt\":\"...\",\"level\":\"na\",\"detail\":\"\"},\"gpu\":{\"usage\":0,\"temp_txt\":\"...\",\"level\":\"na\",\"detail\":\"\"}}"
  "~/.config/eww/scripts/get-stats.py")

  

(defwidget stat_row [icon name usage temp level detail]
  (box :class "stat-row" :orientation "v" :space-evenly false :spacing 6
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "stat-icon" :text icon)
      (label :class "stat-name" :text name :halign "start" :hexpand true)
      (label :class "stat-temp ${level}" :text temp)
    )
    (box :orientation "h" :space-evenly false :spacing 10
      (progress :class "stat-bar" :value usage :hexpand true :valign "center")
      (label :class "popup-val" :text "${usage}%")
    )
    (label :class "stat-detail" :text detail :halign "start")
  )
)

(defwidget stats_menu []
  (eventbox :onhoverlost "eww close stats_popup"
    (box :class "popup-box" :orientation "v" :space-evenly false :spacing 12
      (label :class "popup-header" :text "Estado del Sistema")
      (stat_row :icon "" :name "CPU"
                :usage {stats.cpu.usage} :temp {stats.cpu.temp_txt}
                :level {stats.cpu.level} :detail {stats.cpu.detail})
      (stat_row :icon "󰍛" :name "RAM"
                :usage {stats.ram.usage} :temp {stats.ram.temp_txt}
                :level {stats.ram.level} :detail {stats.ram.detail})
      (stat_row :icon "󰢮" :name "GPU"
                :usage {stats.gpu.usage} :temp {stats.gpu.temp_txt}
                :level {stats.gpu.level} :detail {stats.gpu.detail})
    )
  )
)

(defwindow stats_popup
  :monitor 0
  :stacking "overlay"
  :focusable "ondemand"
  :geometry (geometry :anchor "top center" :x "0px" :y "50px" :width "300px")
  (stats_menu)
)
